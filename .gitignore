# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# IDE files
.idea/
.mcp.json

# Mac Files
.DS_Store
*.md
# Keep the list of proposed improvements under version control
!suggestions.md
# Keep the plan of the sequence comparison task under version control
!implementation_comparison.md
# Keep the plan of the evaluation outputs, sequence augmentations and sequence normalization under version control
!implementation_evaluation_and_sequences.md
# Keep the notes of the documentation folder (architecture benchmarking, suggestions and audit, task workflows) under
# version control
!documentation/**/*.md
# Keep the guide of the tutorial build under version control
!tutorials/README.md

# Model data
experiments_folder/

# Experiments data
experiments/
datasets/
# MLflow local database and artifacts, written in the experiments root folder wherever it points
mlflow.db
mlartifacts/
mlruns/
inspiration_projects/
previous_classifiers/
*experiments*/
# Exported models served by Triton, and the staging folders of exports stopped before removing them
vision_training/deployment/triton/served_models/
.export_staging_*/
# Machine-specific launch copies of the classification and self-supervised configurations, kept on the disk of the
# machine whose datasets they read and out of version control
vision_training/configurations/classification/imagenet_merged/
vision_training/configurations/self_supervised/imagenet_merged/
# Committed run snapshots of the tutorials (tutorials/MAINTAINING.md): copies of small run, dataset and figure files at
# the paths of the experiments folder, whose folder names (hyperparameter_experiments, experiments, datasets) the rules
# above would otherwise ignore, and the guide of the tutorial maintenance
!tutorials/run_snapshots/**
!tutorials/MAINTAINING.md
